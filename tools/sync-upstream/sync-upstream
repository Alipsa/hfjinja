#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/../.."

usage() {
  echo "Usage: tools/sync-upstream/sync-upstream {verify|report|refresh-lock}" >&2
  exit 64
}

case "${1:-}" in
  verify)
    exec ./gradlew upstreamVerify
    ;;
  report)
    git diff --stat -- upstream/vendor upstream/upstream-lock.json upstream/mapping.yml
    ;;
  refresh-lock)
    node <<'NODE'
const crypto = require('node:crypto');
const fs = require('node:fs');
const {execFileSync} = require('node:child_process');

const root = 'upstream/vendor/';
const lockPath = 'upstream/upstream-lock.json';
const lock = JSON.parse(fs.readFileSync(lockPath, 'utf8'));
const files = {};
for (const tracked of execFileSync('git', ['ls-files', '-z', '--', root]).toString().split('\0')) {
  if (!tracked) continue;
  const relative = tracked.slice(root.length);
  files[relative] = crypto.createHash('sha256').update(fs.readFileSync(tracked)).digest('hex');
}
lock.files = Object.fromEntries(Object.entries(files).sort());
fs.writeFileSync(lockPath, `${JSON.stringify(lock, null, 2)}\n`);
NODE
    ;;
  *)
    usage
    ;;
esac
