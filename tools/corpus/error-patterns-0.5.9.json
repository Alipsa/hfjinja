{
  "version": "@huggingface/jinja@0.5.9",
  "patterns": [
    {
      "regex": "^Unknown variable: (?<name>.+)$",
      "category": "UNDEFINED_OR_ACCESS"
    },
    {
      "regex": "^Object keys must be strings: got (?<type>.+)$",
      "category": "TYPE"
    },
    {
      "regex": "^Cannot access property with non-string: got (?<type>.+)$",
      "category": "TYPE"
    },
    {
      "regex": "^Variable already declared: (?<name>.+)$",
      "category": "VALUE"
    },
    {
      "regex": "^Cannot unpack non-iterable type: (?<type>.+)$",
      "category": "TYPE"
    },
    {
      "regex": "^Unknown operator \"(?<op>.+)\" between (?<left>.+) and (?<right>.+)$",
      "category": "TYPE"
    },
    {
      "regex": "^Parser Error: (?<detail>.+)$",
      "category": "SYNTAX"
    },
    {
      "regex": "^Invalid count value: (?<count>-?\\d+)$",
      "category": "VALUE",
      "comment": "tojson(indent) rejects a negative String.repeat count"
    },
    {
      "regex": "^(?<method>startswith|endswith)\\(\\) requires at least one argument$",
      "category": "ARITY"
    },
    {
      "regex": "^(?<method>startswith|endswith)\\(\\) argument must be a string or tuple of strings$",
      "category": "TYPE"
    },
    {
      "regex": "^(?<method>startswith|endswith)\\(\\) tuple elements must be strings$",
      "category": "TYPE"
    }
  ]
}
