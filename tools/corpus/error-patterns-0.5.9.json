{
  "version": "@huggingface/jinja@0.5.9",
  "patterns": [
    {
      "regex": "^Unknown variable: (?<name>.+)$",
      "category": "UNDEFINED_OR_ACCESS"
    },
    {
      "regex": "^Object keys must be strings: got (?<type>.+)$",
      "category": "TYPE"
    },
    {
      "regex": "^Cannot access property with non-string: got (?<type>.+)$",
      "category": "TYPE"
    },
    {
      "regex": "^Variable already declared: (?<name>.+)$",
      "category": "VALUE"
    },
    {
      "regex": "^Cannot unpack non-iterable type: (?<type>.+)$",
      "category": "TYPE"
    },
    {
      "regex": "^Unknown operator \"(?<op>.+)\" between (?<left>.+) and (?<right>.+)$",
      "category": "TYPE"
    },
    {
      "regex": "^Parser Error: (?<detail>.+)$",
      "category": "SYNTAX"
    },
    {
      "regex": "^Invalid count value: (?<count>-?\\d+)$",
      "category": "VALUE",
      "comment": "tojson(indent) rejects a negative String.repeat count"
    },
    {
      "regex": "^(?<method>startswith|endswith)\\(\\) requires at least one argument$",
      "category": "ARITY"
    },
    {
      "regex": "^(?<method>startswith|endswith)\\(\\) argument must be a string or tuple of strings$",
      "category": "TYPE"
    },
    {
      "regex": "^(?<method>startswith|endswith)\\(\\) tuple elements must be strings$",
      "category": "TYPE"
    },
    {
      "regex": "^Unknown (?<type>ArrayValue|StringValue|NumericValue|ObjectValue|BooleanValue) filter: (?<name>.+)$",
      "category": "TYPE"
    },
    {
      "regex": "^Cannot apply filter \"(?<name>.+)\" to type: (?<type>.+)$",
      "category": "TYPE"
    },
    {
      "regex": "^`(?<name>selectattr|rejectattr)` can only be applied to array of objects$",
      "category": "TYPE"
    },
    {
      "regex": "^`map` expressions without `attribute` set are not currently supported\\.$",
      "category": "TYPE"
    },
    {
      "regex": "^wp7-eager-sentinel$",
      "category": "EXPLICIT_RAISE"
    },
    {
      "regex": "^arguments of `(?<name>selectattr|rejectattr)` must be strings$",
      "category": "TYPE"
    },
    {
      "regex": "^Cannot convert to JSON: KeywordArgumentsValue$",
      "category": "TYPE"
    },
    {
      "regex": "^sep argument must be a string or null$",
      "category": "TYPE"
    },
    {
      "regex": "^maxsplit argument must be a number$",
      "category": "TYPE"
    },
    {
      "regex": "^replace\\(\\) arguments must be strings$",
      "category": "TYPE"
    },
    {
      "regex": "^replace\\(\\) requires at least two arguments$",
      "category": "TYPE"
    },
    {
      "regex": "^Object key must be a string: got (?<type>.+)$",
      "category": "TYPE"
    },
    {
      "regex": "^Positional arguments must come before keyword arguments$",
      "category": "SYNTAX"
    }
  ]
}
